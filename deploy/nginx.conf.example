# nginx configuration example for AI Social (social.huyenbao.com)
#
# Why you saw "502 Bad Gateway" on /api/prompts/run:
#   nginx proxies /api/* to 127.0.0.1:8787, but the API server process was not
#   running (pm2 restart all does not create it — it only restarts existing
#   processes). Fix on the server:
#
#     cd /path/to/app
#     git checkout -- package-lock.json   # if needed
#     git pull && npm run build
#     pm2 delete ai-social-api ai-social-web 2>/dev/null || true
#     pm2 start ecosystem.config.cjs --update-env
#     pm2 save
#
#   Also make sure Ollama is running:  systemctl status ollama  (or: ollama serve)
#
# This config routes EVERYTHING (SPA + /api) to the single Node process on
# :8787 (the API now serves the static build/ folder itself with SPA fallback).

server {
    listen 80;
    server_name social.huyenbao.com;

    # Redirect HTTP -> HTTPS if you also have a TLS server block (certbot adds one)
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name social.huyenbao.com;

    # ssl_certificate     /etc/letsencrypt/live/social.huyenbao.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/social.huyenbao.com/privkey.pem;

    # Long AI generations can take minutes — raise the proxy timeouts so nginx
    # does not return 502/504 while the model is still working.
    proxy_read_timeout    360s;
    proxy_send_timeout    360s;
    proxy_connect_timeout 15s;
    proxy_buffering off;          # stream tokens progressively if using SSE
    client_max_body_size  2m;

    location / {
        proxy_pass         http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}

# ---------------------------------------------------------------------------
# ALTERNATIVE: if you want nginx to serve the static build/ itself (faster,
# no Node involvement for assets), use this location block instead and set
# SERVE_STATIC=false in ecosystem.config.cjs:
#
#     root /path/to/app/build;
#     index index.html;
#     location / {
#         try_files $uri $uri/ /index.html;   # SPA fallback (IMPORTANT)
#     }
#     location /api/ {
#         proxy_pass http://127.0.0.1:8787;
#         ... same proxy headers/timeouts as above ...
#     }
# ---------------------------------------------------------------------------

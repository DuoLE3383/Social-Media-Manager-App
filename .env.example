# React only exposes REACT_APP_* values to the browser. These two values are public.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# API server (never prefix secrets with REACT_APP_)
API_PORT=8787
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Optional: expose the local API through a temporary Cloudflare Quick Tunnel for Meta OAuth testing.
# Requires cloudflared installed and on PATH. Each run gets a new URL; update the Meta redirect URI allowlist.
DEV_CLOUDFLARE_TUNNEL=false
RATE_LIMIT_PER_MINUTE=20

# Choose ollama, openai, or anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_MODEL_PREMIUM=qwen2.5:7b
LLM_MODEL_EMBED=nomic-embed-text
OLLAMA_URL=http://127.0.0.1:11434
LLM_TIMEOUT_DEFAULT=90000
LLM_TIMEOUT_PREMIUM=300000
LLM_TIMEOUT_EMBED=30000
LLM_FALLBACK_ENABLED=true
OLLAMA_QUEUE_LIMIT=4

# OpenAI-compatible provider. Keep this server-side only.
OPENAI_API_KEY=
# Optional, for a compatible API host
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Anthropic provider. Keep this server-side only.
ANTHROPIC_API_KEY=
# Optional compatible base URL
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Server-side values used to validate Supabase access tokens
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Facebook Pages API (server-side only)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8787/api/meta/callback
META_GRAPH_VERSION=v26.0
# Optional separate HMAC key for OAuth state; defaults to META_APP_SECRET
META_STATE_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_TOKEN_ENCRYPTION_KEY=

# Threads API (uses the Meta app above if THREADS_APP_ID/SECRET are blank)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8787/api/threads/callback
THREADS_STATE_SECRET=
SUPABASE_STORAGE_BUCKET=threads-media
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_IMAGE_TIMEOUT_MS=600000
# Optional AI Horde account key increases queue priority; anonymous access is free but lowest priority.
# Register at https://aihorde.net/register. Never use a paid provider key for the $0-only setup.
HORDE_API_KEY=0000000000
HORDE_IMAGE_TIMEOUT_MS=900000
